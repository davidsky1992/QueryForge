server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # The app loads only its own bundle and calls only same-origin URLs, so everything else is blocked.
    # This limits what injected script could do with an API key held in page memory.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Resolve the API host per request so nginx starts even if the API is not up yet
    # and follows container IP changes after the API restarts.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # Same-origin reverse proxy: the browser calls /api/... on this host; nginx forwards to the API service.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # $http_host keeps the port the browser used, so absolute URLs from the API (e.g. Location) stay correct.
        proxy_set_header Host $http_host;
        # Overwrite rather than append: a client-supplied X-Forwarded-For is never passed on, so the API sees the
        # real client address for rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    location = /health {
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite emits content-hashed file names, so assets can be cached indefinitely.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA fallback; index.html is never cached so new deployments are picked up immediately.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
