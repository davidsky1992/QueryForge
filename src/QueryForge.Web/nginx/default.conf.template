server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Resolve the API host per request so nginx starts even if the API is not up yet
    # and follows container IP changes after the API restarts.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # Same-origin reverse proxy: the browser calls /api/... on this host; nginx forwards to the API service.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # $http_host keeps the port the browser used, so absolute URLs from the API (e.g. Location) stay correct.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    location = /health {
        proxy_pass $api_upstream;
    }

    location /health/ {
        proxy_pass $api_upstream;
    }

    # Vite emits content-hashed file names, so assets can be cached indefinitely.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA fallback; index.html is never cached so new deployments are picked up immediately.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
