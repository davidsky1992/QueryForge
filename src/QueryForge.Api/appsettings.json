{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Reads": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Writes": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Anonymous": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Health": { "PermitLimit": 60, "WindowSeconds": 60 }
  }
}
