# Build context for the API and migrator images is the repository root.
# Only global.json, Directory.Build.props, and the .NET projects under src/ are needed.

# Secrets and local configuration
.env
.env.*
**/secrets.json
**/appsettings.*.local.json
**/*.pfx

# Host-run development settings stay out of the image; containers are configured through environment variables.
**/appsettings.Development.json

# Build and test output
**/bin/
**/obj/
**/TestResults/
**/coverage/

# Not part of the API image
tests/
docs/
src/QueryForge.Web/
**/node_modules/
**/dist/

# Repository and IDE metadata
.git/
.github/
.vs/
.vscode/
.idea/
**/*.user
**/*.suo
*.md
docker-compose*.yml
**/Dockerfile*
**/.dockerignore
