<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <!-- Hosts the real ASP.NET Core pipeline in-process for HTTP-level tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.31" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Disposable SQL Server container so rowversion, unique indexes, and migrations behave as in production. -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QueryForge.Api\QueryForge.Api.csproj" />
  </ItemGroup>

  <!-- Shared real-socket test helpers (loopback server, simulated public upstream), linked rather than copied. -->
  <ItemGroup>
    <Compile Include="..\QueryForge.Api.Tests\Execution\LoopbackServer.cs" Link="Execution\Shared\LoopbackServer.cs" />
    <Compile Include="..\QueryForge.Api.Tests\Execution\PublicUpstreamSimulator.cs" Link="Execution\Shared\PublicUpstreamSimulator.cs" />
  </ItemGroup>

</Project>
