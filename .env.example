# Copy to .env and replace the placeholder. .env is git-ignored; never commit real values.
# Wrap the value in single quotes if it contains '$' so Docker Compose does not interpolate it.
# SQL Server requires at least 8 characters with three of: uppercase, lowercase, digits, symbols.
# Do not use ';' — the password is embedded in a SQL Server connection string.
MSSQL_SA_PASSWORD=<choose-a-strong-local-password>

# Optional overrides (defaults shown). All ports are bound to 127.0.0.1 only.
# WEB_HOST_PORT=8080
# API_HOST_PORT=5080
# SQLSERVER_HOST_PORT=1433
# REDIS_HOST_PORT=6379
# API_ENVIRONMENT=Development
